# Marea — environment variables
# ---------------------------------------------------------------------------
# Every variable below except the last two blocks is validated once, at
# server boot, by lib/env.ts — a missing or malformed required value stops
# the process from starting with a message naming exactly what's wrong.

# --- Runtime mode -----------------------------------------------------
# Standard Node/Next variable, not read from lib/env.ts. Missing: treated
# as development — the app falls back to localhost for its own origin and
# allows plain http on it, and the seed script's local-target guard is more
# lenient. Set explicitly to "production" in any real deployment (the
# Dockerfile in this repo already does).
# NODE_ENV="development"

# --- Database (required) -----------------------------------------------
# Plain Postgres 17+, local or hosted — no managed-provider dependency.
# Missing: the app refuses to start.
DATABASE_URL="postgresql://marea:password@localhost:5432/marea"

# Only needed if a transaction-mode pooler (pgbouncer and similar) sits in
# front of the app — that mode doesn't support the prepared statements
# `prisma migrate` uses, and it silently breaks LISTEN, which the real-time
# board and kitchen screen use. Read by prisma.config.ts (migrations) and by
# the realtime listener, which holds one connection of its own outside the
# pool. Missing: DATABASE_URL is used for both, which is correct for a plain
# Postgres connection.
# DIRECT_URL=""

# Connection pool size for the app's own long-lived process (not relevant
# in serverless). Missing: defaults to 25 — see the comment beside this
# field in lib/env.ts for the formula behind that number.
# DATABASE_POOL_MAX="25"

# Overrides which schema the app queries — every real deployment leaves
# this unset and gets Postgres's own default, "public". Only the
# integration test harness (test/db.ts) sets it, to give each vitest
# worker its own throwaway schema.
# DATABASE_SCHEMA=""

# --- Auth & canonical origin (required) ---------------------------------
# Session/cookie signing secret. Generate with: openssl rand -base64 32
# Missing: the app refuses to start.
AUTH_SECRET=""

# Auth.js's own canonical URL for this deployment. Missing in production
# with APP_ORIGIN also unset: the app refuses to start (rather than risk
# printing a QR code pointing at localhost). In development, falls back to
# http://localhost:3000.
AUTH_URL="http://localhost:3000"

# This deployment's canonical origin, if different from AUTH_URL (e.g. a
# reverse proxy in front of the app). Missing: falls back to AUTH_URL.
# APP_ORIGIN=""

# --- Reverse proxy / networking (optional) -------------------------------
# How many proxies between the client and this app rewrite (not append to)
# x-forwarded-for — see docs/DEPLOY.md for the nginx config this assumes.
# Missing: defaults to 1 (a single trusted reverse proxy, e.g. Vercel or a
# correctly configured nginx). Set to 0 if the app is exposed with no proxy
# in front of it at all.
# TRUSTED_PROXY_COUNT="1"

# How long an order-tracking SSE connection stays open before a scheduled,
# client-invisible reconnect (milliseconds). Missing: defaults to 75000.
# Set to 0 to disable the cutoff entirely on a long-lived deployment.
# SSE_MAX_LIFETIME_MS="75000"

# How the board, the kitchen screen and order tracking learn that something
# changed: "auto" (default) listens for Postgres notifications and falls back
# to polling every 10 s by itself if it cannot; "poll" never listens. Use
# "poll" only where LISTEN is known not to work.
# REALTIME_MODE="auto"

# --- Image storage (optional) --------------------------------------------
# "local" (disk, served by this app) or "s3" (any S3-compatible provider —
# MinIO, R2, B2, Hetzner, AWS). Missing: defaults to "local".
# STORAGE_DRIVER="local"

# Only used when STORAGE_DRIVER=local. Missing: defaults to "./data/media"
# — in Docker, this is where the named `media` volume should be mounted.
# STORAGE_LOCAL_DIR="./data/media"

# Custom domain/CDN in front of the storage host (either driver). Missing
# with STORAGE_DRIVER=s3: falls back to the S3 endpoint's own hostname.
# Not needed at all with STORAGE_DRIVER=local.
# MEDIA_HOSTNAME=""

# --- S3-compatible storage (required only if STORAGE_DRIVER=s3) ---------
# Any of these missing while STORAGE_DRIVER=s3: the app refuses to start.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="marea-media"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Outbound email (optional) --------------------------------------------
# "console" (prints, sends nothing — the default, no credentials needed),
# "smtp" (nodemailer, any provider that speaks SMTP), or "resend". Missing:
# defaults to "console".
# MAIL_DRIVER="console"

# From address/name every outbound email uses. MAIL_FROM_EMAIL is required
# when MAIL_DRIVER is "smtp" or "resend"; MAIL_FROM_NAME defaults to "Marea".
# MAIL_FROM_EMAIL="notifications@example.com"
# MAIL_FROM_NAME="Marea"

# --- SMTP (required only if MAIL_DRIVER=smtp) -----------------------------
# Any real SMTP server — Postfix, Zoho, Brevo, Mailgun, SES's SMTP
# interface — or a local MailHog (docker-compose.yml already runs one on
# localhost:1025, web UI at localhost:8025). SMTP_HOST missing while
# MAIL_DRIVER=smtp: the app refuses to start.
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""

# --- Resend (required only if MAIL_DRIVER=resend) -------------------------
# RESEND_API_KEY="re_..."

# --- Notification worker (optional) ---------------------------------------
# Bearer secret app/api/cron/notifications requires — the serverless way to
# drive the queue when there's no long-running process for scripts/worker.ts.
# Missing: that endpoint refuses every request. Generate with: openssl rand
# -base64 32
# CRON_SECRET=""

# --- Status endpoint (optional) --------------------------------------------
# Bearer token app/api/status requires to return the per-check breakdown
# (worker heartbeat, notification queue, backup age) instead of just a status
# code. Missing: /api/status still answers with the right status code, but
# the detail is never returned to anyone. Generate with: openssl rand -base64 32
# STATUS_CHECK_TOKEN=""

# --- Stripe (required to accept card payments) ---------------------------
# Test-mode keys: https://dashboard.stripe.com/test/apikeys
# Missing: card payments and the webhook fail; cash-register collection
# still works.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# `stripe listen` mints its own value for local forwarding — different
# from the Dashboard's webhook secret. See README.md.
# Two endpoints, two secrets (docs/DEPLOY.md): this one signs events about the
# platform's own account (/api/webhooks/stripe)...
STRIPE_WEBHOOK_SECRET=""
# ...and this one, events about connected accounts (/api/webhooks/stripe/connect).
# In production, with STRIPE_SECRET_KEY set, missing either stops the boot.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# --- Seed script safety (local dev only) ---------------------------------
# npm run db:seed refuses to run unless DIRECT_URL/DATABASE_URL points at
# an obvious loopback address — the seeded accounts have passwords
# published in README.md. Set this to seed anywhere else on purpose; never
# set it in a deployment's own environment.
# I_KNOW_WHAT_IM_DOING=""

# --- Database roles (row level security) --------------------------------
# DATABASE_URL must connect as marea_app, NOT as the role that owns the tables:
# row level security does not apply to an owner or a superuser, so with that
# role every policy is silently a no-op. The app refuses to start in
# production if it finds out (DATABASE_ROLE_CHECK, default "enforce").
# WORKER_DATABASE_URL connects as marea_worker, directly (not through a
# transaction-mode pooler: it also carries the LISTEN connection). DIRECT_URL,
# if you set it, is for migrations and belongs to the owner; keep it out of
# the running app's environment.
# WORKER_DATABASE_URL=""
# DATABASE_ROLE_CHECK="enforce"

# --- Tenant provisioning (read by `npm run tenants` only, never by the app,
# and never falls back to DIRECT_URL/DATABASE_URL) -------------------------
# Owner connection scripts/tenants.ts uses to create organizations and
# businesses by hand. Its own variable on purpose, same reasoning as the
# backup script below: a CLI that infers where to connect from whatever
# DATABASE_URL happens to be set to in the shell is one stale variable away
# from writing to the wrong database.
# TENANTS_OWNER_DATABASE_URL="postgresql://marea:password@localhost:5432/marea"

# --- Multi-tenant -------------------------------------------------------
# The domain business subdomains hang off: marea.<this>, cala.<this>. Set it
# once a deployment hosts more than one business. Unset, the deployment is
# single-origin: its only business answers on every hostname, and a second
# business makes the bare domain ambiguous (404). Locally, "localhost" works
# with marea.localhost:3000. Emails, QR codes and the sitemap use each
# business's own subdomain once this is set.
# BUSINESS_ROOT_DOMAIN=""

# --- Docker Compose only (not read by the app itself) --------------------
# Postgres password for the `db` service in docker-compose.yml.
# POSTGRES_PASSWORD=""
# Passwords for the two restricted roles the app and the worker connect as
# (row level security binds them, not the owner above). The `migrate` service
# sets them; `npm run db:provision-roles` does the same by hand.
# APP_DB_PASSWORD=""
# WORKER_DB_PASSWORD=""

# --- Backups (read by `npm run ops:backup` only, never by the app) --------
# The backup script reads these by name from its own environment and nothing
# else: no .env file, and no DATABASE_URL or DIRECT_URL. In Compose they are
# passed to the `ops` service; set them in the host's environment or secret
# store, not in a file next to the code. Every value below is a placeholder.
# Database connection as the OWNER (pg_dump must see every row past row level
# security). Compose builds it for you from POSTGRES_PASSWORD.
# BACKUP_DATABASE_URL="postgresql://owner:change-me@db:5432/marea"
# The age PUBLIC key (age1...): the server can encrypt but never decrypt. The
# private key lives outside the server (see docs/RUNBOOK.md).
# BACKUP_AGE_RECIPIENT="age1replace-with-your-public-key"
# S3-compatible bucket in an account other than the media's, created with
# `npm run ops:backup-bucket`. The key needs only PutObject and
# PutObjectRetention: it can add backups, and cannot read, list or delete.
# BACKUP_S3_ENDPOINT="https://s3.backup-provider.example"
# BACKUP_S3_BUCKET="marea-backups"
# BACKUP_S3_REGION="us-east-1"
# BACKUP_S3_ACCESS_KEY_ID="write-only-key-id"
# BACKUP_S3_SECRET_ACCESS_KEY="write-only-key-secret"
# COMPLIANCE (default: nobody can delete before the date) or GOVERNANCE.
# BACKUP_LOCK_MODE="COMPLIANCE"
# Pinged after every successful run; the monitor alerts on silence.
# BACKUP_MONITOR_URL="https://monitor.example/ping/replace-me"
# Folder archived with the database when STORAGE_DRIVER=local (Compose sets it).
# BACKUP_MEDIA_DIR="/data/media"

# --- Scheduled maintenance (docker/ops-crontab; read by the `scheduler`
# service's tasks, never by the app itself) --------------------------------
# Told about after a purge, the media sweep, or the monthly overdue-guests
# report finish successfully; each one alerts on its own silence.
# OPS_MONITOR_PURGE_IP_URL="https://monitor.example/ping/replace-me"
# OPS_MONITOR_RATE_LIMITS_URL="https://monitor.example/ping/replace-me"
# OPS_MONITOR_MEDIA_SWEEP_URL="https://monitor.example/ping/replace-me"
# OPS_MONITOR_ANONYMIZE_ALERT_URL="https://monitor.example/ping/replace-me"
# Where the monthly "N businesses are overdue for guest anonymization"
# report goes. Unset: the report is skipped, not sent nowhere. Anonymizing
# is still `npm run privacy:anonymize-guests`, run by hand — this only
# makes sure someone is told it's due.
# OPS_ALERT_EMAIL="owner@example.com"
