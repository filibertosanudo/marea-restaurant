# The main server's base URL — no trailing slash needed.
SERVER_URL=https://your-restaurant.example.com

# From "New device" (or "Rotate token") in the panel's
# Configuración > Dispositivos tab. Shown once; if lost, rotate it there.
DEVICE_TOKEN=

# The kitchen printer's own IP on the restaurant's network and its ESC/POS
# port — 9100 on essentially every network thermal printer.
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# How often to check the server for new tickets, in milliseconds.
POLL_INTERVAL_MS=2000
