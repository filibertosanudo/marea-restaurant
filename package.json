{
  "name": "marea-restaurant",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:lib": "tsup components/index.ts --format esm,cjs --dts --out-dir dist --tsconfig tsconfig.lib.json",
    "build:css": "tailwindcss -i ./styles/lib.css -o ./dist/styles.css --minify",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stripe/stripe-js": "^9.14.0",
    "client-only": "^0.0.1",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.4.49",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
